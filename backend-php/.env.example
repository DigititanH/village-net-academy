# Village NetAcad — copy to .env (filename must be .env NOT .env.txt)
# Local:  copy .env.example .env
# cPanel: use deploy/env.cpanel.template → upload as backend-php/.env

PORT=5000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=village_netacad
DB_USER=root
DB_PASSWORD=
# DB_SSL_CA=database/DigiCertGlobalRootG2.crt.pem

UPLOADS_DIR=uploads

JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000

PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_SANDBOX=true
PAYFAST_NOTIFY_URL=http://localhost:5000/api/payfast/notify
PAYFAST_PASSPHRASE=

# CCNA PayFast — SA Pay Now subscription (R450 × 6 monthly) + international signed subscription
CCNA_SA_PAYNOW_AMOUNT=550
CCNA_SA_PAYNOW_CYCLES=6
CCNA_SA_PAYNOW_FREQUENCY=3
CCNA_INTL_PAYNOW_AMOUNT=850
CCNA_SUBSCRIPTION_FREQUENCY=3
CCNA_SUBSCRIPTION_CYCLES=3

SITE_EMAIL=info@villagenetacad.co.za
MAIL_MAILER=smtp
MAIL_HOST=mail.digititan.co.za
MAIL_PORT=587
MAIL_USERNAME=noreply@villagenetacad.co.za
MAIL_PASSWORD=YOUR_EMAIL_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@villagenetacad.co.za
MAIL_FROM_NAME="Village NetAcad"
SMTP_HOST=mail.digititan.co.za
SMTP_PORT=587
SMTP_USER=noreply@villagenetacad.co.za
SMTP_PASS=YOUR_EMAIL_PASSWORD
SMTP_ENCRYPTION=tls
SMTP_FROM=noreply@villagenetacad.co.za
SMTP_FROM_NAME="Village NetAcad"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
